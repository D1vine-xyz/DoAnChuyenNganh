# Google Gemini API Key (Đăng ký miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID cho tính năng "Đăng nhập bằng Google"
# Lấy miễn phí tại: https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID -> Web application)
# Authorized JavaScript origins: http://localhost:8000 và http://127.0.0.1:8000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Khóa bí mật ký JWT Access Token (tùy chọn)
JWT_SECRET_KEY=veritext-ai-super-secret-jwt-key-2026-academic-thesis

# Cấu hình Microsoft SQL Server (mặc định localhost / VeriTextAI)
DB_SERVER=localhost
DB_NAME=VeriTextAI
